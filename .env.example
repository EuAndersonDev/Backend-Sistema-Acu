JWT_SECRET=sua_chave_secreta_muito_segura_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# ========================================
# Mercado Pago Configuration
# Integração completa com payment gateway brasileiro
# ========================================

# Access Token - Obter em: https://www.mercadopago.com/developers/panel
# Sandbox (teste): APP_USR_xxxx...
# Produção: APP_USR_yyyy...
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Key - Obter no mesmo painel
# Usado no frontend para inicializar integração
MERCADO_PAGO_PUBLIC_KEY=APP_USR_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notification URL - Webhook para receber atualizações de pagamento
# Mercado Pago enviará POST para esta URL quando:
# - Pagamento é aprovado (approved)
# - Pagamento é recusado (rejected)
# - Pagamento está pendente (pending)
# - Reembolso é processado (refunded)
# 
# Desenvolvimento local:
#   - Usar ngrok: ngrok http 3000
#   - MERCADO_PAGO_NOTIFICATION_URL=https://abc123.ngrok.io/api/payments/webhook
# 
# Produção:
#   - MERCADO_PAGO_NOTIFICATION_URL=https://seu-dominio-real.com/api/payments/webhook
#   - Certificado SSL obrigatório
MERCADO_PAGO_NOTIFICATION_URL=https://seu-dominio.com/api/payments/webhook

# ========================================
# Frontend URLs
# ========================================
# URL para redirecionar após pagamento aprovado
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/success

# URL para redirecionar após pagamento recusado
PAYMENT_FAILURE_URL=http://localhost:3000/checkout/failure

# URL para redirecionar quando pagamento está pendente (PIX, transferência)
PAYMENT_PENDING_URL=http://localhost:3000/checkout/pending

# ========================================
# Webhook Validation (Segurança Adicional)
# ========================================
# Chave secreta para validar webhooks
# Recomendado em produção para garantir que webhook vem do Mercado Pago
# Se vazio, validação é pulada
WEBHOOK_SECRET=sua_chave_secreta_para_validar_webhooks

# ========================================
# Email Configuration (Opcional - Notificações)
# ========================================
# Para enviar confirmações de pedido, recibos, etc
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app-google

# ========================================
# Resend Configuration (Contact Form)
# ========================================
# API Key - Obter em: https://resend.com/api-keys
# Usado para enviar emails do formulário de contato
RESEND_API_KEY=re_fsumhz9A_Jjo4Q3Zx9TTy8EhkH9LJdpAF
CONTACT_RECEIVER_EMAIL=acumateriascontrucao@gmail.com
CONTACT_FROM_ADDRESS=Contact Form <onboarding@resend.dev>
RESEND_ACCOUNT_EMAIL=seu-email-da-conta-resend@exemplo.com

# Observação:
# - Quando usar 'onboarding@resend.dev' no FROM, a Resend só entrega para o email da conta.
# - Em produção, verifique um domínio e use um FROM do seu domínio, ex.:
#   CONTACT_FROM_ADDRESS=Contact Form <contato@seu-dominio-verificado.com>

# ========================================
# Logging
# ========================================
# DEBUG=express:* - Para logs detalhados do Express
# DEBUG=sequelize:* - Para logs de SQL
LOG_LEVEL=info

SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@acu.com.br

# ========================================
# Logging
# ========================================
LOG_LEVEL=debug
